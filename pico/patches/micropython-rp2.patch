diff --git a/ports/rp2/CMakeLists.txt b/ports/rp2/CMakeLists.txt
index ee6f1b8..e81fddf 100644
--- a/ports/rp2/CMakeLists.txt
+++ b/ports/rp2/CMakeLists.txt
@@ -562,8 +562,10 @@ else(PICO_RP2040)
 endif()
 
 if(PICO_RP2350)
+    # 12 KB of RAM below scratch Y: SeedSigner's screens call the camera's QR reader 20-odd Python calls deep,
+    # and past a 12 KB stack it overwrote the GC heap's top
     target_link_options(${MICROPY_TARGET} PRIVATE
-        -Wl,--defsym=__micropy_extra_stack__=4096
+        -Wl,--defsym=__micropy_extra_stack__=12288
     )
 endif()
 
diff --git a/ports/rp2/mpconfigport.h b/ports/rp2/mpconfigport.h
index 3084531..833026c 100644
--- a/ports/rp2/mpconfigport.h
+++ b/ports/rp2/mpconfigport.h
@@ -139,7 +139,7 @@
 #define MICROPY_PY_SYS_PLATFORM                 "rp2"
 #ifndef MICROPY_PY_THREAD
 #define MICROPY_PY_THREAD                       (1)
-#define MICROPY_PY_THREAD_GIL                   (0)
+#define MICROPY_PY_THREAD_GIL                   (1) // core1's thread shares the VM, as CPython's threads do
 #define MICROPY_THREAD_YIELD()                  mp_handle_pending(MP_HANDLE_PENDING_CALLBACKS_AND_EXCEPTIONS)
 #endif
 
diff --git a/ports/rp2/mphalport.h b/ports/rp2/mphalport.h
index c63354c..ba8c24a 100644
--- a/ports/rp2/mphalport.h
+++ b/ports/rp2/mphalport.h
@@ -57,13 +57,16 @@
 //
 // Do not use this macro directly, include py/runtime.h and
 // call mp_event_wait_indefinite() or mp_event_wait_ms(timeout)
+// The GIL is let go while waiting, so a sleeping thread lets the other core's run
 #define MICROPY_INTERNAL_WFE(TIMEOUT_MS) \
     do {                                 \
+        MP_THREAD_GIL_EXIT(); \
         if ((TIMEOUT_MS) < 0) { \
             __wfe(); \
         } else { \
             mp_wfe_or_timeout(TIMEOUT_MS); \
         } \
+        MP_THREAD_GIL_ENTER(); \
     } while (0)
 
 extern int mp_interrupt_char;
diff --git a/ports/rp2/mpthreadport.c b/ports/rp2/mpthreadport.c
index 043a878..c0476f7 100644
--- a/ports/rp2/mpthreadport.c
+++ b/ports/rp2/mpthreadport.c
@@ -45,6 +45,13 @@ static void *core1_arg = NULL;
 static uint32_t *core1_stack = NULL;
 static size_t core1_stack_num_words = 0;
 
+// core1 runs one thread at a time, so one static stack serves them all: allocating each from the GC heap
+// fails once the heap fragments, and a MemoryError there left core1 claimed by a thread that never started.
+#ifndef MICROPY_HW_CORE1_STACK_BYTES
+#define MICROPY_HW_CORE1_STACK_BYTES (16 * 1024)
+#endif
+static uint32_t core1_static_stack[MICROPY_HW_CORE1_STACK_BYTES / sizeof(uint32_t)];
+
 // Thread mutex.
 static recursive_mutex_t atomic_mutex;
 
@@ -83,17 +90,21 @@ void mp_thread_init(void) {
 void mp_thread_deinit(void) {
     assert(get_core_num() == 0);
     // Must ensure that core1 is not currently holding the GC lock, otherwise
-    // it will be terminated while holding the lock.
+    // it will be terminated while holding the lock. With the GIL, which core0 holds here, it cannot be.
+    #if !MICROPY_PY_THREAD_GIL
     mp_thread_recursive_mutex_lock(&MP_STATE_MEM(gc_mutex), 1);
+    #endif
     multicore_reset_core1();
     core1_entry = NULL;
+    #if !MICROPY_PY_THREAD_GIL
     mp_thread_recursive_mutex_unlock(&MP_STATE_MEM(gc_mutex));
+    #endif
 }
 
 void mp_thread_gc_others(void) {
     if (core1_entry != NULL) {
-        // Collect core1's stack if it is active.
-        gc_collect_root((void **)&core1_stack, 1);
+        // Collect core1's stack if it is active; it is static, so its contents are the roots.
+        gc_collect_root((void **)core1_stack, core1_stack_num_words);
         gc_collect_root((void **)&core1_arg, 1);
     }
     if (get_core_num() == 1) {
@@ -132,25 +143,18 @@ mp_uint_t mp_thread_create(void *(*entry)(void *), void *arg, size_t *stack_size
     core1_entry = entry;
     core1_arg = arg;
 
-    if (*stack_size == 0) {
-        *stack_size = 4096; // default stack size
-    } else if (*stack_size < 2048) {
-        *stack_size = 2048; // minimum stack size
-    }
-
-    // Round stack size to a multiple of the word size.
-    core1_stack_num_words = *stack_size / sizeof(uint32_t);
-    *stack_size = core1_stack_num_words * sizeof(uint32_t);
-
-    // Allocate stack.
-    core1_stack = m_new(uint32_t, core1_stack_num_words);
+    // The requested size is ignored: every thread gets the static stack.
+    core1_stack = core1_static_stack;
+    core1_stack_num_words = MP_ARRAY_SIZE(core1_static_stack);
+    *stack_size = sizeof(core1_static_stack);
 
     // Create thread on core1.
     multicore_reset_core1();
     multicore_launch_core1_with_stack(core1_entry_wrapper, core1_stack, *stack_size);
 
-    // Adjust stack_size to provide room to recover from hitting the limit.
-    *stack_size -= 512;
+    // Adjust stack_size to provide room to recover from hitting the limit. The stack is static, so going
+    // past it overwrites what lies below: 2 KB leaves room for C deeper than 512 bytes.
+    *stack_size -= 2048;
 
     return 2; // mp_thread_get_id() result for core 1
 }
